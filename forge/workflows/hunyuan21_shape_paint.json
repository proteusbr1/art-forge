{
  "1": {"class_type": "Hy3D21LoadImageWithTransparency", "inputs": {"image": "$IMAGE$"}},
  "2": {"class_type": "Hy3D21VAELoader", "inputs": {"model_name": "hunyuan3d-vae-v2-1-fp16.ckpt"}},
  "3": {"class_type": "Hy3D21MeshGenerator", "inputs": {"model": "hunyuan3d-dit-v2-1-fp16.ckpt", "image": ["1", 2], "steps": 30, "guidance_scale": 7.5, "seed": "$SEED$", "attention_mode": "sdpa"}},
  "4": {"class_type": "Hy3D21VAEDecode", "inputs": {"vae": ["2", 0], "latents": ["3", 0], "box_v": 1.01, "octree_resolution": 384, "num_chunks": 32000, "mc_level": 0.0, "mc_algo": "mc", "enable_flash_vdm": true, "force_offload": true}},
  "5": {"class_type": "Hy3D21PostprocessMesh", "inputs": {"trimesh": ["4", 0], "remove_floaters": true, "remove_degenerate_faces": true, "reduce_faces": true, "max_facenum": "$FACES$", "smooth_normals": false}},
  "6": {"class_type": "Hy3D21ExportMesh", "inputs": {"trimesh": ["5", 0], "filename_prefix": "$PREFIX$", "file_format": "glb"}},
  "7": {"class_type": "Hy3D21MeshUVWrap", "inputs": {"trimesh": ["5", 0]}},
  "8": {"class_type": "Hy3D21CameraConfig", "inputs": {"camera_azimuths": "0, 90, 180, 270, 0, 180", "camera_elevations": "0, 0, 0, 0, 90, -90", "view_weights": "1, 0.5, 1, 0.5, 1, 1", "ortho_scale": 1.1}},
  "9": {"class_type": "Hy3DMultiViewsGenerator", "inputs": {"trimesh": ["7", 0], "camera_config": ["8", 0], "view_size": 768, "image": ["1", 2], "steps": 10, "guidance_scale": 3.0, "texture_size": 2048, "unwrap_mesh": false, "seed": "$SEED$"}},
  "10": {"class_type": "Hy3DBakeMultiViews", "inputs": {"pipeline": ["9", 0], "camera_config": ["8", 0], "albedo": ["9", 1], "mr": ["9", 2]}},
  "11": {"class_type": "Hy3DInPaint", "inputs": {"pipeline": ["10", 0], "albedo": ["10", 1], "albedo_mask": ["10", 2], "mr": ["10", 3], "mr_mask": ["10", 4], "output_mesh_name": "$MESHNAME$"}},
  "12": {"class_type": "SaveImage", "inputs": {"images": ["11", 0], "filename_prefix": "$PREFIX$"}},
  "13": {"class_type": "SaveImage", "inputs": {"images": ["11", 1], "filename_prefix": "$PREFIX$"}},
  "14": {"class_type": "SaveImage", "inputs": {"images": ["9", 1], "filename_prefix": "$PREFIX$"}},
  "15": {"class_type": "Hy3D21PostprocessMesh", "inputs": {"trimesh": ["4", 0], "remove_floaters": true, "remove_degenerate_faces": true, "reduce_faces": false, "max_facenum": 40000, "smooth_normals": false}},
  "16": {"class_type": "Hy3D21ExportMesh", "inputs": {"trimesh": ["15", 0], "filename_prefix": "$PREFIX$", "file_format": "glb"}}
}
