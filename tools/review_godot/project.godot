; Review sheets of the factory's humanoids (tools/review_godot): renders GLBs off screen
; into one PNG and exits. See main.gd for the command line.
config_version=5

[application]

config/name="art-forge review"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/driver="Dummy"

[display]

window/size/viewport_width=64
window/size/viewport_height=64
window/size/initial_position_type=0
window/size/initial_position=Vector2i(-20000, -20000)
window/size/borderless=true
window/size/no_focus=true
window/energy_saving/keep_screen_on=false

[rendering]

renderer/rendering_method="forward_plus"
